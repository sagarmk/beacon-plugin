{
  "name": "beacon",
  "version": "1.0.0",
  "description": "Beacon \u2014 semantic code search for Claude Code",
  "author": {
    "name": "Sagar MK"
  },
  "license": "MIT",
  "repository": "https://github.com/sagarmk/beacon-plugin",
  "homepage": "https://github.com/sagarmk/beacon-plugin",
  "keywords": [
    "claude-code",
    "semantic-search",
    "code-search",
    "embeddings"
