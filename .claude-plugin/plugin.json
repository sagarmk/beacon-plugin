    "./commands/config.md",
    "./commands/blacklist.md",
    "./commands/whitelist.md",
    "./commands/run-indexer.md",
    "./commands/terminate-indexer.md"
  ],
  "agents": [
    "./agents/code-explorer.md"
  ],
  "mcpServers": {
    "beacon": {
      "command": "node",
